# ──────────────────────────────────────────────────────────────
# AUTHENTICATION (NextAuth v4)
# Set ALL of these in Vercel → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# LinkedIn OAuth — create app at https://developer.linkedin.com/
# Authorized redirect URL (add in LinkedIn app settings):
#   https://<your-vercel-domain>/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of your deployment (used for OAuth callbacks).
# Local: http://localhost:3000
# Production: https://<your-vercel-domain>
AUTH_URL=http://localhost:3000

# Admin LinkedIn member ID (providerAccountId).
# How to find yours:
#   1. npm run dev → sign in with LinkedIn
#   2. Visit /api/auth/me → copy the "id" field
ADMIN_LINKEDIN_ID=
