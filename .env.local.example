# ──────────────────────────────────────────────────────────────
# AUTHENTICATION (NextAuth v4 — AUTH_* names are bridged to NEXTAUTH_*)
# Set ALL of these in the Vercel Project → Settings → Environment Variables.
# If LinkedIn credentials are missing in production, the login page shows a
# clear configuration error — it NEVER falls back to mock authentication.
# ──────────────────────────────────────────────────────────────

# LinkedIn OAuth — create app at https://developer.linkedin.com/
# Add this exact Authorized redirect URL in the LinkedIn app:
#   https://<your-domain>/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Session signing secret. Generate with: openssl rand -base64 32
# AUTH_SECRET is preferred; NEXTAUTH_SECRET also works.
AUTH_SECRET=your_random_secret_here

# Canonical URL of the deployment (used for OAuth callbacks).
# Local: http://localhost:3000  •  Production: https://<your-domain>
# AUTH_URL is bridged to NEXTAUTH_URL automatically.
AUTH_URL=http://localhost:3000

# Administrator is determined server-side by matching the authenticated
# LinkedIn email against this value (email match => role "admin").
ADMIN_LINKEDIN_EMAIL=you@example.com

# ──────────────────────────────────────────────────────────────
# OWNER_LINKEDIN_ID — Your own LinkedIn OpenID sub (member ID), optional.
#   1. npm run dev  →  2. /login → sign in with LinkedIn
#   3. Visit /api/auth/me and copy the "id" field
# ──────────────────────────────────────────────────────────────
OWNER_LINKEDIN_ID=your_linkedin_member_id
NEXT_PUBLIC_OWNER_LINKEDIN_ID=your_linkedin_member_id

# Production site URL used by next-sitemap (set in Vercel dashboard too)
SITE_URL=https://your-domain.com
