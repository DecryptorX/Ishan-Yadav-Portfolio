# LinkedIn OAuth — create app at https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ──────────────────────────────────────────────────────────────
# OWNER_LINKEDIN_ID — Your own LinkedIn OpenID sub (member ID).
#
# How to get it:
#   1. Run the dev server:  npm run dev
#   2. Visit http://localhost:3000/resume
#   3. Click "Sign in with LinkedIn" and complete the OAuth flow
#   4. Visit http://localhost:3000/api/auth/me
#   5. Copy the "id" field from the JSON response
#   6. Paste it below (looks like: ACoAA...  or a numeric string)
# ──────────────────────────────────────────────────────────────
OWNER_LINKEDIN_ID=your_linkedin_member_id
NEXT_PUBLIC_OWNER_LINKEDIN_ID=your_linkedin_member_id

# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here

# Dev URL — change to your production domain before deploying
NEXTAUTH_URL=http://localhost:3000

# Production site URL used by next-sitemap (set in Vercel dashboard too)
SITE_URL=https://your-domain.com
