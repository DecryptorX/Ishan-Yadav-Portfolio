    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "^4.24.14",
    "next-sitemap": "latest",
    "next-themes": "^0.4.6",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@tailwindcss/forms": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
